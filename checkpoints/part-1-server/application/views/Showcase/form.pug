extends ../default/master/layoutblocks

block content
    div(class='content-section bounded-xlarge color4')
        div(class='wrapper width-max-600')
            .spacer-4
            .card(class="color0 equally-spaced-1 dropshadow")
                if $project && isset($project->id)
                    h2.medium-text.semibold Edit project
                    - $action = $home . 'projects/' . $project->id
                else
                    h2.medium-text.semibold New project
                    - $action = $home . 'projects'
                form(method='POST', action=$action)
                    =csrf()
                    if $project && isset($project->id)
                        =methodField('PUT')
                    .mb-3
                        label.default-text.textcolor5(for='title') * title
                        input#title.form-control.input-default(type='text', name='title', maxlength='150', required, value=($project->title ?? ''))
                        if isset($errors['title'])
                            .text-danger.small-text #{$errors['title']}
                    .mb-3
                        label.default-text.textcolor5(for='description') * description
                        textarea#description.form-control.input-default(name='description', rows='5', required) #{$project->description ?? ''}
                        if isset($errors['description'])
                            .text-danger.small-text #{$errors['description']}
                    .spacer-2
                    input.btn.btn-secondary.w-100(type='submit', value='Save')
                .spacer-2
                a(href="{$home}projects") cancel
    .spacer-3
